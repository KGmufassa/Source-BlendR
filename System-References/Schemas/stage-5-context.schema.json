{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-5-context.schema.json",
  "title": "Stage 5 Shared Context",
  "type": "object",
  "required": [
    "format_version",
    "artifact_id",
    "artifact_type",
    "stage",
    "status",
    "selected_stack",
    "stage_contract_profile",
    "guidance_policy",
    "source_inputs",
    "assumptions",
    "risks",
    "reference_integrity"
  ],
  "properties": {
    "format_version": { "const": "2.0" },
    "artifact_id": { "const": "ARTIFACT-S5-CONTEXT" },
    "artifact_type": { "const": "stage_context" },
    "stage": { "const": "Stage 5" },
    "status": { "type": "string" },
    "selected_stack": { "type": "object" },
    "stage_contract_profile": { "type": "object" },
    "guidance_policy": { "type": "object" },
    "source_inputs": {
      "type": "object",
      "required": ["stage_1", "stage_2", "stage_3", "stage_4"],
      "properties": {
        "stage_1": { "type": "array", "items": { "type": "string" } },
        "stage_2": { "type": "array", "items": { "type": "string" } },
        "stage_3": { "type": "array", "items": { "type": "string" } },
        "stage_4": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "execution_decision_refs": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array" },
    "risks": { "type": "array" },
    "unresolved_questions": { "type": "array" },
    "reference_integrity": { "type": "object" },
    "risk_acceptance_ledger": { "type": "object" },
    "revision_loops": { "type": "array" }
  },
  "additionalProperties": true
}
