{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-5-artifact.schema.json",
  "title": "Stage 5 Planning Artifact",
  "type": "object",
  "required": [
    "format_version",
    "artifact_id",
    "artifact_type",
    "stage",
    "status"
  ],
  "properties": {
    "format_version": { "const": "2.0" },
    "artifact_id": { "type": "string", "pattern": "^ARTIFACT-S5-" },
    "artifact_type": {
      "enum": [
        "development_roadmap",
        "implementation_sequence",
        "engineering_dependencies",
        "testing_strategy",
        "build_tickets",
        "agent_assignment_plan",
        "parallel_execution_plan",
        "release_plan",
        "revision_build_tickets",
        "revision_repair_tickets",
        "stage_5_revision_ticket_plan"
      ]
    },
    "stage": { "const": "Stage 5" },
    "status": { "type": "string" },
    "context_ref": { "const": "Build-Plans/Stage-5/00-stage-context.json" },
    "traceability_refs": { "type": "array", "items": { "type": "string" } },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": [
              "development_roadmap",
              "implementation_sequence",
              "engineering_dependencies",
              "testing_strategy",
              "build_tickets",
              "agent_assignment_plan",
              "parallel_execution_plan",
              "release_plan"
            ]
          }
        }
      },
      "then": { "required": ["context_ref", "traceability_refs", "data"] }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "development_roadmap" } } },
      "then": { "properties": { "data": { "required": ["development_roadmap", "workstreams", "milestones"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "implementation_sequence" } } },
      "then": { "properties": { "data": { "required": ["implementation_sequence", "implementation_slices", "sequence_dependencies", "validation_checkpoints"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "engineering_dependencies" } } },
      "then": { "properties": { "data": { "required": ["engineering_dependencies", "dependency_graph", "blocked_work"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "testing_strategy" } } },
      "then": { "properties": { "data": { "required": ["testing_strategy"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "build_tickets" } } },
      "then": { "properties": { "data": { "required": ["ticket_count", "tickets", "indexes", "execution_queue"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "agent_assignment_plan" } } },
      "then": { "properties": { "data": { "required": ["assignment_plan", "agents", "ticket_assignments", "slice_assignments"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "parallel_execution_plan" } } },
      "then": { "properties": { "data": { "required": ["parallel_execution_plan", "batches", "parallel_batch_ids", "serial_batch_ids"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "release_plan" } } },
      "then": { "properties": { "data": { "required": ["release_plan"] } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "stage_5_revision_ticket_plan" } } },
      "then": {
        "required": [
          "created_at",
          "revision_id",
          "supersedes_or_extends",
          "summary_ref",
          "prototype_ref",
          "ticket_id_range",
          "goal",
          "execution_policy",
          "source_of_truth_policy",
          "route_component_mapping",
          "data"
        ],
        "properties": {
          "data": { "required": ["ticket_count", "tickets", "batches"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": ["revision_build_tickets", "revision_repair_tickets"]
          }
        }
      },
      "then": {
        "required": [
          "revision_id",
          "summary_ref",
          "prototype_ref",
          "ticket_id_range",
          "data"
        ],
        "properties": {
          "data": { "required": ["ticket_count", "tickets", "batches"] }
        }
      }
    }
  ],
  "additionalProperties": true
}
