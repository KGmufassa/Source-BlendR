{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-5-manifest.schema.json",
  "title": "Stage 5 Output Manifest",
  "type": "object",
  "required": [
    "format_version",
    "artifact_id",
    "artifact_type",
    "stage",
    "status",
    "context_ref",
    "artifacts",
    "stage_6_handoff",
    "completion_status",
    "schema_validation"
  ],
  "properties": {
    "format_version": { "const": "2.0" },
    "artifact_id": { "const": "ARTIFACT-S5-MANIFEST" },
    "artifact_type": { "const": "stage_manifest" },
    "stage": { "const": "Stage 5" },
    "status": { "type": "string" },
    "context_ref": { "const": "Build-Plans/Stage-5/00-stage-context.json" },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "path", "data_path", "schema_ref"],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^ARTIFACT-S5-" },
          "artifact_type": { "type": "string" },
          "path": { "type": "string" },
          "data_path": { "type": "string" },
          "schema_ref": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "stage_6_handoff": { "type": "object" },
    "completion_status": { "type": "object" },
    "schema_validation": { "type": "object" }
  },
  "additionalProperties": true
}
