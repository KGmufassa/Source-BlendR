generator client {
  provider     = "prisma-client"
  output       = "../packages/shared/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id           String        @id @default(cuid())
  clerkOrgId   String        @unique
  name         String
  locale       String        @default("en-US")
  timezone     String        @default("UTC")
  currency     String        @default("USD")
  measurementSystem String   @default("metric")
  logoUrl      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vendors      Vendor[]
  catalogItems CatalogItem[]
  importJobs   ImportJob[]
  sessions     DiscoverySession[]
  sources      NormalizedSourceRecord[]
  credentials  AIProviderCredential[]
  aiRoutes     AIProviderRoute[]
  auditEvents  AuditEvent[]
  catalogs     Catalog[]
  members      WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("org:member")
  displayName String?
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model Vendor {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  websiteUrl  String?
  description String?
  logoUrl     String?
  contactName String?
  contactRole String?
  contactEmail String?
  contactPhone String?
  address     String?
  defaultImportMethod String @default("website")
  offeringType String?
  offeringCategories String[] @default([])
  offeringDescription String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       CatalogItem[]
  importJobs  ImportJob[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model CatalogItem {
  id          String    @id @default(cuid())
  workspaceId String
  vendorId    String?
  type        String    @default("product")
  name        String
  description String    @default("")
  sku         String
  priceCents  Int
  vendorPriceCents Int?
  inventoryQuantity Int @default(0)
  currency    String
  category    String    @default("")
  imageUrl    String?
  status      String    @default("active")
  attributes  Json      @default("{}")
  tags        String[]  @default([])
  sourceCandidateId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  catalogMemberships CatalogMember[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([vendorId])
}

model Catalog {
  id           String          @id @default(cuid())
  workspaceId  String
  name         String
  categoryType String
  status       String          @default("draft")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      CatalogMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model CatalogMember {
  id            String       @id @default(cuid())
  workspaceId   String
  catalogId     String
  candidateId   String?
  catalogItemId String?
  customPriceCents Int?
  createdAt     DateTime     @default(now())
  catalog       Catalog      @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  candidate     CandidateItem? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([catalogId, candidateId])
  @@unique([catalogId, catalogItemId])
  @@index([workspaceId, catalogId])
}

model ImportJob {
  id             String   @id @default(cuid())
  workspaceId    String
  vendorId       String?
  sourceType     String
  sourceUri      String
  status         String   @default("queued")
  requestedByUserId String
  idempotencyKey String?
  attempt        Int      @default(1)
  errorCode      String?
  canceledAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor         Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  events         ImportJobEvent[]
  sources        NormalizedSourceRecord[]
  session        DiscoverySession?

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
}

model ImportJobEvent {
  id          String   @id @default(cuid())
  workspaceId String
  jobId       String
  type        String
  detail      Json     @default("{}")
  createdAt   DateTime @default(now())
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId, jobId, createdAt])
}

model NormalizedSourceRecord {
  id          String   @id @default(cuid())
  workspaceId String
  jobId       String
  sourceHash  String
  sourceType  String
  sourceUri   String
  payload     Json
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidates  CandidateItem[]

  @@unique([workspaceId, sourceHash])
  @@index([workspaceId, jobId])
}

model DiscoverySession {
  id          String   @id @default(cuid())
  workspaceId String
  importJobId String   @unique
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  candidates  CandidateItem[]

  @@index([workspaceId, status])
}

model CandidateItem {
  id             String   @id @default(cuid())
  workspaceId    String
  sessionId      String
  sourceRecordId String?
  state          String   @default("new")
  name           String
  sku            String
  priceCents     Int
  currency       String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  session        DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceRecord   NormalizedSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  catalogMemberships CatalogMember[]

  @@unique([workspaceId, sessionId, sku])
  @@index([workspaceId, sessionId, state])
}

model AIProviderCredential {
  id                  String   @id @default(cuid())
  workspaceId         String
  provider            String
  encryptedCredential String
  enabled             Boolean  @default(true)
  lastConnectionStatus String?
  lastConnectionCheckedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routes              AIProviderRoute[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String
  action      String
  entityType  String
  entityId    String
  detail      Json     @default("{}")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AIProviderRoute {
  id          String   @id @default(cuid())
  workspaceId String
  capability  String
  providerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    AIProviderCredential? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, capability])
  @@index([workspaceId])
  @@index([providerId])
}
