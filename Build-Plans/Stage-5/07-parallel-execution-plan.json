{
  "stage": "Stage 5",
  "status": "ready_for_stage_6",
  "selected_stack": {
    "stack_decision_id": "STACK-003",
    "frontend": {
      "framework": "Next.js App Router",
      "language": "TypeScript",
      "ui_runtime": "React",
      "styling": "Tailwind CSS with shadcn/ui-compatible component primitives",
      "state": "Server Components and server actions for standard flows; client state only for interactive discovery/catalog workflows"
    },
    "backend": {
      "framework": "Next.js route handlers and server actions",
      "runtime": "Node.js LTS",
      "language": "TypeScript",
      "api_style": "Route Handler -> Domain Service -> Repository -> Prisma for REST-style JSON endpoints and app-owned mutations",
      "background_jobs": "Separate TypeScript BullMQ worker on Redis for all long-running tasks"
    },
    "monorepo": {
      "workspace_tooling": "pnpm workspaces",
      "apps": [
        "apps/web",
        "apps/worker"
      ],
      "packages": {
        "packages/domain": "Domain services, use cases, orchestration, business logic, and service interfaces consumed by web and worker.",
        "packages/ai": "AI Capability Router, provider adapter interfaces, provider implementations, request/response normalization, and provider health checks.",
        "packages/scrapers": "Playwright website discovery, navigation tree extraction, PDF/OCR import connectors, and raw artifact collection.",
        "packages/shared": "Shared utilities, config helpers, logging, errors, constants, and cross-cutting primitives.",
        "packages/validation": "Deterministic validation rules, duplicate checks, SKU/price/category rules, and candidate-to-catalog import gates.",
        "packages/types": "Shared TypeScript types, DTOs, schemas, queue payloads, and API contracts."
      }
    },
    "domain_service_layer": {
      "request_flow": "Route Handler / Server Action -> Domain Service -> Repository -> Prisma -> PostgreSQL",
      "worker_flow": "BullMQ Processor -> Domain Service -> Repository -> Prisma -> PostgreSQL",
      "rule": "Business logic lives in domain services and validation package, not directly inside route handlers, server actions, or queue processors."
    },
    "database": {
      "primary": "PostgreSQL",
      "orm_or_query_layer": "Prisma",
      "search": "PostgreSQL full-text search for MVP; external search deferred until scale evidence exists",
      "migration_strategy": "Prisma migrations"
    },
    "storage": {
      "provider": "Backblaze B2",
      "usage": "PDF uploads, generated PDFs/PNGs, import snapshots, rendered DOM snapshots when retained"
    },
    "authentication": {
      "provider_or_strategy": "Clerk Organizations",
      "tenant_model": "Workspace maps to Clerk organization and application workspace_id",
      "authorization": "Application-enforced RBAC with workspace_owner for MVP"
    },
    "hosting_and_deployment": {
      "web_and_api": "Vercel",
      "workers": "Fly.io TypeScript worker service with Playwright runtime",
      "database": "Neon PostgreSQL",
      "redis": "Upstash Redis",
      "object_storage": "Backblaze B2",
      "observability": "Sentry plus structured logs and queue/job metrics"
    },
    "testing_stack": {
      "unit": "Vitest",
      "route_integration": "Vitest against route handlers/server actions through domain services",
      "worker_integration": "Vitest against BullMQ processors through domain services",
      "e2e": "Playwright",
      "database": "Prisma test database migrations",
      "security": "tenant-isolation integration tests and credential handling checks"
    },
    "package_manager": "pnpm",
    "ai_and_external_services": [
      {
        "service": "AI Capability Router",
        "status": "stable interface for all AI integrations"
      },
      {
        "service": "OpenAI-compatible provider adapter",
        "status": "MVP default adapter"
      },
      {
        "service": "Ollama provider adapter",
        "status": "local model option"
      },
      {
        "service": "Anthropic provider adapter",
        "status": "post-MVP adapter unless required earlier"
      },
      {
        "service": "Google/Gemini provider adapter",
        "status": "post-MVP adapter unless required earlier"
      },
      {
        "service": "Tesseract OCR",
        "status": "MVP OCR fallback for PDFs"
      }
    ],
    "pipeline_architecture": {
      "scraping_pipeline": "External source -> connector/scraper -> raw import artifact -> normalized source record -> Discovery Session candidate seed",
      "ai_enrichment_pipeline": "Normalized source record or catalog candidate -> AI Capability Router -> Provider Adapter -> enrichment result -> validation -> candidate/catalog update",
      "separation_rule": "Scraping collects and normalizes source data; AI enrichment is independently repeatable and can re-enrich stored normalized source records without re-scraping.",
      "re_enrichment_support": "Persist normalized source records and import artifacts with version/source hashes so users can rerun enrichment after changing provider, prompt, capability route, or validation rules."
    },
    "rationale": "A Next.js full-stack monorepo with a separate BullMQ worker is the simplest scalable architecture: route handlers and server actions stay thin, all business logic is centralized in shared domain services, workers reuse the same domain services, scraping and AI enrichment remain independent pipelines, and the AI Capability Router/Provider Adapter interface remains stable for all AI integrations.",
    "rejected_alternatives": [
      {
        "alternative": "Next.js-only including long-running workers",
        "reason": "Too risky for Playwright/OCR/AI jobs; workers must scale and run independently."
      },
      {
        "alternative": "Python/FastAPI backend",
        "reason": "Adds a second language while frontend, Playwright, and worker ecosystem remain TypeScript-heavy."
      },
      {
        "alternative": "Microservices from day one",
        "reason": "Over-engineered before scale evidence; monorepo packages plus separate worker are enough."
      },
      {
        "alternative": "External search service for MVP",
        "reason": "Unnecessary until catalog scale proves PostgreSQL full-text insufficient."
      }
    ],
